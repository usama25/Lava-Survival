            vec3(0.0, 0.0, 0.0));\n    u_xlat4.xyz = (-vs_TEXCOORD7.xyz) + _WorldSpaceCameraPos.xyz;\n   
            u_xlat30 = dot(u_xlat4.xyz, u_xlat4.xyz);\n    u_xlat30 = inversesqrt(u_xlat30);\n   
            u_xlat4.xyz = vec3(u_xlat30) * u_xlat4.xyz;\n    u_xlatb30 = unity_OrthoParams.w==0.0;\n   
            u_xlat16_2.x = (u_xlatb30) ? u_xlat4.x : hlslcc_mtx4x4unity_MatrixV[0].z;\n   
            u_xlat16_2.y = (u_xlatb30) ? u_xlat4.y : hlslcc_mtx4x4unity_MatrixV[1].z;\n   
            u_xlat16_2.z = (u_xlatb30) ? u_xlat4.z : hlslcc_mtx4x4unity_MatrixV[2].z;\n   
            u_xlat16_31 = dot((-u_xlat16_2.xyz), u_xlat0.xyz);\n    u_xlat16_31 =
