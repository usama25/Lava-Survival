            vec3(0.0, 0.0, 0.0));\n    u_xlat0.xyz = _MainLightColor.xyz * unity_LightData.zzz;\n   
            u_xlat16_2.xyz = vec3(u_xlat16_16) * u_xlat0.xyz;\n    u_xlat10_0 = texture2D(_BaseMap,
