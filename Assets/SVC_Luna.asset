            * u_xlat16_2.xyz;\n    SV_Target0.xyz = u_xlat16_1.xyz * u_xlat16_0.xyz
            + u_xlat16_2.xyz;\n    u_xlatb4.x = _Surface==1.0;\n    SV_Target0.w
            = (u_xlatb4.x) ? u_xlat16_0.w : 1.0;\n    return;\n}\n\n"
