            + vec3(-0.0549999997, -0.0549999997, -0.0549999997);\n    u_xlat5.x =
            (u_xlatb5.x) ? u_xlat16_3.x : u_xlat6.x;\n    u_xlat5.y = (u_xlatb5.y)
