            = u_xlat0.yzzx * u_xlat0.xyzz;\n    u_xlat16_3.x = dot(unity_SHBr, u_xlat16_1);\n   
            u_xlat16_3.y = dot(unity_SHBg, u_xlat16_1);\n    u_xlat16_3.z = dot(unity_SHBb,
            u_xlat16_1);\n    u_xlat16_2.xyz = unity_SHC.xyz * u_xlat16_2.xxx + u_xlat16_3.xyz;\n   
            u_xlat16_32 = dot(u_xlat0.xyz, _MainLightPosition.xyz);\n    u_xlat16_32
            = clamp(u_xlat16_32, 0.0, 1.0);\n    u_xlat0.w = 1.0;\n    u_xlat16_3.x
