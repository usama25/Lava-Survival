            hlslcc_movcTemp.y = (u_xlatb5.y) ? u_xlat16_1.y : u_xlat4.y;\n       
            hlslcc_movcTemp.z = (u_xlatb5.z) ? u_xlat16_1.z : u_xlat4.z;\n       
