            = u_xlat1.x + (-_SoftParticleFadeParams.x);\n        u_xlat1.x = -abs(u_xlat4)
            + u_xlat1.x;\n        u_xlat1.x = u_xlat1.x * _SoftParticleFadeParams.y;\n       
            u_xlat1.x = clamp(u_xlat1.x, 0.0, 1.0);\n    } else {\n        u_xlat1.x
            = 1.0;\n    }\n    SV_Target0.xyz = u_xlat16_0.xyz;\n    u_xlat16_2 =
            u_xlat16_0.w * u_xlat1.x;\n    u_xlat1.x = vs_TEXCOORD6.z / vs_TEXCOORD6.w;\n   
            u_xlat1.x = _ZBufferParams.z * u_xlat1.x + _ZBufferParams.w;\n    u_xlat1.x
            = float(1.0) / u_xlat1.x;\n    u_xlat1.x = u_xlat1.x + (-_CameraFadeParams.x);\n   
